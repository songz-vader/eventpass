{
  "name": "eventpass",
  "version": "1.0.0",
  "private": true,
  "description": "EventPass backend + web app: hosts, events, guest invites, SMS/WhatsApp delivery, check-in.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node --watch server/index.js",
    "test": "node --test --test-concurrency=1",
    "users": "node scripts/users.js",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "demo": "node demo/build.mjs",
    "reset-db": "node scripts/reset-db.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
